# Supabase — aus dem Projekt unter Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Nur serverseitig verwendet. Niemals in den Browser geben.
SUPABASE_SERVICE_ROLE_KEY=

# Adresse der Anwendung — landet in den Links der Benachrichtigungs-E-Mails.
# Auf Vercel darf die Zeile leer bleiben: dort erkennt die Anwendung die
# Produktionsdomain selbst.
NEXT_PUBLIC_APP_URL=http://localhost:3400

# E-Mail-Versand über Resend. Ohne diese beiden Werte bleiben die
# Benachrichtigungen auf die Glocke in der Anwendung beschränkt.
RESEND_API_KEY=
RESEND_FROM=Urlaubsverwaltung <urlaub@example.com>
